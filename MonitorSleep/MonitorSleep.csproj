<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>MonitorSleep</AssemblyName>
    <RootNamespace>MonitorSleep</RootNamespace>

    <!-- 程序图标：资源管理器、任务栏、快捷方式都用它 -->
    <ApplicationIcon>app.ico</ApplicationIcon>

    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>显示器睡眠助手</Product>
    <AssemblyTitle>显示器睡眠助手</AssemblyTitle>
    <Description>按需关闭显示器省电，并在不该关屏时保持屏幕常亮。</Description>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 高 DPI + 中文界面字体 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- 本项目刻意不引用任何 NuGet 包：保证离线 restore 可用 -->
    <RestorePackages>false</RestorePackages>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

</Project>

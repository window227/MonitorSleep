# ─────────────── 构建产物 ───────────────
bin/
obj/
dist/

# ─────────────── 本地工具链 ───────────────
# .tools 里是本机下载的 .NET SDK（约 714MB）和 NuGet 配置，绝不能入库
.tools/

# ─────────────── 运行期产物 ───────────────
# 配置正常写在 %APPDATA%\MonitorSleep；
# 只有在受限环境下才会回退到 exe 旁边的这个目录
MonitorSleep-data/
crash.log
last-run.txt

# ─────────────── 设计过程遗留 ───────────────
# 托盘图标由 TrayIconFactory 用代码绘制，这些早期预览图已不再需要
icon-preview/

# ─────────────── 杂项 ───────────────
# 输入法等其它程序误写进工作区的日志
debug.log
*.log
*.tmp
*.user
.vs/
.idea/

# 我在调试时抓的临时截图（都以点开头）
.*.png
.*.log
